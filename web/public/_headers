# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/graph/manifest.json
  Cache-Control: no-cache
/graph/*
  Cache-Control: public, max-age=86400
/assets/*
  Cache-Control: public, max-age=31536000, immutable
